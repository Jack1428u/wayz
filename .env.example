# Copia este archivo como ".env" (agente) y ".env.local" (aplicación web)
# --- Agente de IA: clave de https://aistudio.google.com ---
GEMINI_API_KEY=
# Opcional: modelo a usar (consulta los vigentes en https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Base de datos (Supabase > Project Settings > API) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Notificaciones por correo (Resend) ---
RESEND_API_KEY=re_...
EMAIL_FROM="Wayz Alertas <alertas@tudominio.com>"
EMAIL_ANALISTA_DEFAULT="analista@wayz.demo"
